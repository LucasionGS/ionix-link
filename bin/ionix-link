#!/usr/bin/env python3
"""ionix-link — the desktop side of Ionix Link, the phone companion.

One file, stdlib only, two roles:

    ionix-link daemon   Long-running (systemd/ionix-link.service). Serves paired
                        phones over TLS on TCP 47110, answers UDP discovery on
                        47110, and takes CLI requests on a unix socket.
    ionix-link <cmd>    Everything else is a thin client of that socket.

The wire protocol is PROTOCOL.md at the repository root; this file follows it
and does not restate it. Section numbers below (§5) point there.

What the daemon does for a phone is done by *plugins*, one class each below,
listed in PLUGINS. A plugin names the tools it needs (`grim`, `wtype`,
`playerctl`...); one whose tools are missing is simply not offered in `ready`,
so the phone never shows a tile that cannot work. Adding a plugin means one
`Plugin` subclass and one entry in PLUGINS (and the phone-side client).

Nothing here talks to a desktop service through a library. It shells out:
busctl (notifications), playerctl, wpctl/pactl (media), wl-copy/wl-paste,
wtype, grim, hyprctl or wlr-randr, notify-send, xdg-open, qrencode, awww, magick or
ffmpeg, and openssl. The one exception is the pointer: a small Wayland client
speaking zwlr_virtual_pointer_v1 over the compositor socket, because no CLI
tool moves a pointer relatively at touchpad rates without a process per event.

Files (§10; every path has an environment override for testing in a scratch dir):

    $XDG_DATA_HOME/ionix/link/       host.json, cert.pem, key.pem, devices.json (0600)
    $XDG_STATE_HOME/ionix/link/      state.json, for the desktop shell to read
    $XDG_CONFIG_HOME/ionix/link/     config.json, commands.json (the user's)
    $XDG_RUNTIME_DIR/ionix-link.sock the control socket (§9)

Concurrency: a single asyncio event loop. TLS server, UDP endpoint, control
socket and every tool subprocess are asyncio objects; nothing blocks the loop
(no subprocess.run, no time.sleep). Writes to one connection go through its
own lock so a screen frame and a reply never interleave.
"""

import asyncio
import collections
import copy
import errno
import glob
import hashlib
import hmac
import html
import ipaddress
import json
import math
import os
import re
import secrets
import shutil
import signal
import socket
import ssl
import stat
import struct
import subprocess
import sys
import tempfile
import time
import traceback
import urllib.parse
import urllib.request

VERSION = "0.1.0"

# ── Protocol constants (PROTOCOL.md) ───────────────────────────────────────

PROTOCOL = 1                       # highest protocol version spoken
PROTOCOL_MIN = 1                   # lowest protocol version spoken
URI_VERSION = 1                    # `v` of the pairing URI
DEFAULT_PORT = 47110               # TCP and UDP

KIND_JSON = 0
KIND_BINARY = 1

MAX_FRAME_UNAUTH = 64 * 1024       # frame `length` before `ready`
MAX_FRAME = 8 * 1024 * 1024        # frame `length` after `ready`
MAX_JSON = 1024 * 1024             # one JSON message
MAX_TEXT = 512 * 1024              # clipboard / input text, UTF-8 bytes
MAX_DATAGRAM = 1024                # UDP discovery
MAX_PENDING_CONNECTIONS = 16       # sockets not yet `ready` ...
MAX_UNREADY_PER_ADDRESS = 4        # ... and of those, per source address (the oldest is closed to make room)
MAX_HANDSHAKES = 64                # TLS handshakes in progress at once
MAX_ID = 2147483647

HANDSHAKE_TIMEOUT = 10             # s, TLS accept → ready
TLS_HANDSHAKE_TIMEOUT = 5          # s for the TLS handshake itself
FIRST_FRAME_TIMEOUT = 5            # s after the handshake for the first frame
PAIR_CONFIRM_TIMEOUT = 10          # s from pair.challenge to pair.confirm
PAIR_CODE_PER_ADDRESS = 3          # tokenless pair.requests per source address per pairing window
PAIR_TOKEN_TTL = 120               # s, QR token lifetime
PAIR_CODE_TTL = 60                 # s, pairing B: desktop user's answer
PING_IDLE = 20                     # s with nothing received → send ping
DEAD_PEER = 45                     # s with nothing received → close
RING_TIMEOUT = 10                  # s for the phone's status.ring reply
AUTH_FAIL_LIMIT = 5                # failures per device ...
AUTH_FAIL_WINDOW = 60              # ... within this many s → locked this many s
DISCOVERY_RATE = 10                # announces per second, in total
NOTIFY_KEEP = 50                   # open notifications remembered for notifications.list
NOTIFY_SUMMARY_MAX = 512           # characters of a mirrored notification's summary ...
NOTIFY_BODY_MAX = 4096             # ... and body (§2: nothing over 1 MiB goes on the wire)
PHONE_NOTIFY_KEEP = 100            # phone notifications remembered per phone (§8.10); older ones just stop being tracked
PHONE_CLOSE_PARALLEL = 8           # busctl calls at once when a phone leaves and its notifications are closed
PHONE_KEY_MAX = 1024               # characters of a phone notification's key
PHONE_HINT = "x-ionix-link"        # hint on every notification the daemon posts for a phone, so the monitor skips it
MEDIA_DEBOUNCE = 0.15              # s
COMMAND_TIMEOUT = 10               # s a command may run before the reply says detached
COMMAND_TIMEOUT_MAX = 25           # s, so the reply still beats the phone's 30 s commands.run timeout
COMMAND_OUTPUT_TAIL = 4096         # bytes of output returned with showOutput
SCREEN_STALL = 30                  # s without screen.ack → screen.stopped "stalled"
SCREEN_VIDEO_LAG = 0.3             # s of frames (at maxFps, at least 6) sent but not acked before video drops frames
SCREEN_VIDEO_FLUSH = 0.003         # s of silence from the encoder that ends the access unit it is writing
SCREEN_VIDEO_FIRST = 5             # s an encoder may take to write its first access unit
SCREEN_VIDEO_BPP = 0.002           # default bitrate: bits per pixel per frame for each point of `quality`
H264_ENCODERS = ("h264_vaapi", "h264_nvenc", "libx264")   # tried in this order; one that fails is skipped
H264_RETRY = 600                   # s a hardware encoder that wrote no frame is left out before it is tried again
H264_DEMOTE_AFTER = 3              # runs in a row without a frame that demote a hardware encoder that once worked
VAAPI_DEVICE = "/dev/dri/renderD128"
THEME_POLL = 2                     # s between theme file checks
ART_FETCH_MAX = 16 * 1024 * 1024   # bytes of cover art read from a file or URL before giving up
ART_FETCH_TIMEOUT = 5              # s per socket operation of an http(s) cover download ...
ART_FETCH_TOTAL = 15               # ... and for the whole download
ART_CACHE = 16                     # scaled covers kept, by (artUrl, maxSize)
SHARE_MAX_SIZE = 4 * 1024 * 1024 * 1024   # bytes of one shared file
SHARE_CHUNK = 1024 * 1024          # bytes of data in one share.chunk
SHARE_DISK_MARGIN = 64 * 1024 * 1024      # bytes that must stay free on the download disk after a file
SHARE_DISK_CHECK = 64 * 1024 * 1024       # bytes written to one file between free space checks
SHARE_IDLE = 60                    # s without a chunk before a transfer is dropped
SHARE_WATCH = 5                    # s between checks for that
SHARE_NAME_MAX = 200               # bytes of a saved file name (the part file adds about 20 of the filesystem's 255)
SHARE_NOTIFY_TTL = 30              # s a "file received" notification keeps its Open / Show in folder buttons

