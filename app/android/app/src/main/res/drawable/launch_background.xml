<?xml version="1.0" encoding="utf-8"?>
<!-- Splash before Android 12: the Ionix logo on the deepest background, so the app never flashes white
     before its own (always dark) UI draws. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ionix_bg_deep" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
