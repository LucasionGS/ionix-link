<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The app is always dark, whatever the OS's dark mode says, so one pair of themes serves both. -->

    <!-- While the process starts: the splash, removed when Flutter draws its first frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <!-- Behind the Flutter UI from then on. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/ionix_bg_deep</item>
    </style>
</resources>
