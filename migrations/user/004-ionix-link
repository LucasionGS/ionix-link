#!/usr/bin/env bash
# Ionix Link's daemon is a user unit. New accounts get it enabled by a skel link
# (graphical-session.target.wants/ionix-link.service), but accounts made before
# the package existed have none, so the phone app finds no desktop. This enables
# it once. A user who disables it afterwards keeps it off: a migration runs once
# per user.
#
# Ships with ionix-link, next to the unit it enables. Ionix's ionix-migrate runs
# it once per user at login; off Ionix nothing does.

set -euo pipefail

UNIT=ionix-link.service

# No user manager to talk to (no pam_systemd on this login): retried at the next one.
if ! systemctl --user show-environment > /dev/null 2>&1; then
  echo "  No systemd user manager in this login; Ionix Link will be enabled at a later one." >&2
  exit 1
fi

# Already enabled (the skel link), or masked on purpose: nothing to do.
case "$(systemctl --user is-enabled "$UNIT" 2>/dev/null || true)" in
  enabled|enabled-runtime|masked|masked-runtime) exit 0 ;;
esac

systemctl --user enable --quiet "$UNIT"
# Inside a running desktop session the target is already up, so start it now rather than at the next login.
if systemctl --user is-active --quiet graphical-session.target; then
  systemctl --user start "$UNIT"
  echo "  Ionix Link is now running for this account. Pair a phone with: ionix-link pair"
else
  echo "  Ionix Link is now enabled for this account and starts with the desktop. Pair a phone with: ionix-link pair"
fi
